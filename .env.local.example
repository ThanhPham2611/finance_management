# Lay 2 gia tri nay trong Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI phan bo luong + Chatbot AI (Giai doan 2) — lay tai console.anthropic.com.
# KHONG duoc dat prefix NEXT_PUBLIC_ (se lo key ra trinh duyet). Khong dat
# = 2 tinh nang AI se bao loi ro rang khi bam nut, phan con lai cua app
# van chay binh thuong.
ANTHROPIC_API_KEY=
# Tuy chon — de trong se dung model mac dinh trong src/lib/ai/client.ts
# (hien la Claude Haiku, model re nhat, du dung cho phan loai chi tieu/
# de xuat % don gian). Chi doi sang model dat hon (Sonnet/Opus) neu thay
# Haiku tra loi chua du tot — kiem tra ten model moi nhat truoc khi dat:
# https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=
