{
  "name": "finance_management",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "mobile": "npm run start --workspace @hu/mobile",
    "mobile:ios": "npm run ios --workspace @hu/mobile",
    "mobile:android": "npm run android --workspace @hu/mobile",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "node --test scripts/*.test.mjs && vitest run && npm run test --workspace @hu/mobile",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "db:types": "npx supabase gen types typescript --linked --schema public > packages/database/src/database.types.ts",
    "check:tz": "tsx scripts/check-tz.mjs",
    "check:secrets": "node scripts/check-mobile-secrets.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@hu/data": "*",
    "@hu/database": "*",
    "@hu/design-tokens": "*",
    "@hu/domain": "*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
